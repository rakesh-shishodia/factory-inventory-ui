{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Copy to the gitignored wrangler.production.jsonc and supply the real IDs.
  // Protect the exact hostname with Access before enabling workers_dev.
  "name": "factory-inventory",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ECWID_MODE": "live",
    "ECWID_STORE_ID": "2442119",
    "INVENTORY_ENABLED": "false",
    "LIVE_SYNC_ENABLED": "false",
    "ORDER_SYNC_ENABLED": "false",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "STAFF_EMAILS": "",
    "ADMIN_EMAILS": ""
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "factory-inventory-production",
    "database_id": "REPLACE_WITH_NEW_INVENTORY_ONLY_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "factory-inventory-sync" }],
    "consumers": [{ "queue": "factory-inventory-sync", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 3 }]
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
