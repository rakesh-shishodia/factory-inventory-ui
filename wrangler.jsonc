{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "factory-inventory-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ECWID_MODE": "demo",
    "LIVE_SYNC_ENABLED": "false",
    "ORDER_SYNC_ENABLED": "false",
    "ECWID_STORE_ID": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": "",
    "STAFF_EMAILS": "",
    "INVENTORY_ENABLED": "false"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "inventory-local",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "migrations"
  }],
  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "inventory-sync-local" }],
    "consumers": [{ "queue": "inventory-sync-local", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 3 }]
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
